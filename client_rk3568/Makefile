CROSS_COMPILE := /mnt/rk3568_sdk/sdk/rk3568_linux_sdk/buildroot/output/rockchip_rk3568/host/bin/aarch64-buildroot-linux-gnu-

CC := $(CROSS_COMPILE)gcc


SYSROOT := /mnt/rk3568_sdk/sdk/rk3568_linux_sdk/buildroot/output/rockchip_rk3568/host/aarch64-buildroot-linux-gnu/sysroot


# ============================================================
# 编译参数
# ============================================================
CFLAGS := -Wall -Wextra -O2 \
          --sysroot=$(SYSROOT) \
          -I$(SYSROOT)/usr/include \
          -I$(SYSROOT)/usr/include/libdrm


# ============================================================
# 链接参数
# ============================================================
LDFLAGS := --sysroot=$(SYSROOT) \
           -L$(SYSROOT)/usr/lib


# ============================================================
# 使用的库
#
# drm            DRM/KMS LCD显示
# rockchip_mpp   Rockchip MPP H264编码
# pthread        多线程
#
# TCP socket属于libc，不需要额外链接socket库
# ============================================================
LDLIBS := -ldrm \
          -lrockchip_mpp \
          -pthread


# ============================================================
# 最终程序
# ============================================================
TARGET := main


# ============================================================
# 所有源文件
# ============================================================
SRCS := main.c \
        imx415.c \
        DRM_lcd.c \
        mpp.c \
        tcp_client.c


# 自动转换：
#
# main.c       -> main.o
# imx415.c     -> imx415.o
# ...
# ============================================================
OBJS := $(SRCS:.c=.o)


.PHONY: all clean


# ============================================================
# 默认目标
# ============================================================
all: $(TARGET)


# ============================================================
# 链接
# ============================================================
$(TARGET): $(OBJS)
	$(CC) $^ -o $@ $(LDFLAGS) $(LDLIBS)


# ============================================================
# 编译每一个.c
# ============================================================
%.o: %.c
	$(CC) $(CFLAGS) -pthread -c $< -o $@


# ============================================================
# 清理
# ============================================================
clean:
	rm -f $(TARGET) $(OBJS)